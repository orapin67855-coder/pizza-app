{
  "name": "@pizza/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Supabase schema, RLS policies and Edge Functions for PIZZA",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start -x studio,imgproxy,logflare,vector,realtime,storage-api,postgres-meta,supavisor",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --level warning",
    "e2e": "node scripts/e2e-local.mjs",
    "e2e:upgrade": "node scripts/e2e-upgrade-account.mjs",
    "e2e:care": "node scripts/e2e-care-links.mjs",
    "e2e:client": "node scripts/e2e-client-sync.mjs",
    "admin:set-role": "node scripts/set-role.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "supabase": "^3.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
